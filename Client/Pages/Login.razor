@page "/login"
@inject IUserAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Log in</PageTitle>

<div class="card mx-auto" style="max-width: 420px">
    <div class="card-body">
        <h1 class="h4 mb-3">Log in</h1>

        @if (error is not null)
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <EditForm Model="user" OnValidSubmit="LoginAsync">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Email</label>
                <InputText class="form-control" type="email" @bind-Value="user.Email" autocomplete="username" />
                <ValidationMessage For="() => user.Email" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText class="form-control" type="password" @bind-Value="user.Password" autocomplete="current-password" />
                <ValidationMessage For="() => user.Password" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@busy">@(busy ? "Logging in..." : "Log in")</button>
        </EditForm>

        <p class="mt-3 mb-0 small">No account yet? <a href="register">Register</a></p>
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private Login user = new();
    private string? error;
    private bool busy;

    private async Task LoginAsync()
    {
        busy = true;
        error = null;
        var result = await AccountService.LoginAsync(user);
        busy = false;

        if (!result.Flag)
        {
            error = result.Message;
            return;
        }

        //Only follow local return addresses
        var target = string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.Contains("://") ? "" : ReturnUrl;
        Navigation.NavigateTo(target);
    }
}

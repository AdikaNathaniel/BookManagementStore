@page "/register"
@inject IUserAccountService AccountService

<PageTitle>Register</PageTitle>

<div class="card mx-auto" style="max-width: 420px">
    <div class="card-body">
        <h1 class="h4 mb-3">Create an account</h1>

        <StatusMessage Response="result" />

        @if (result is { Flag: true })
        {
            <a class="btn btn-primary w-100" href="login">Continue to log in</a>
        }
        else
        {
            <EditForm Model="user" OnValidSubmit="RegisterAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Full name</label>
                    <InputText class="form-control" @bind-Value="user.FullName" autocomplete="name" />
                    <ValidationMessage For="() => user.FullName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" type="email" @bind-Value="user.Email" autocomplete="email" />
                    <ValidationMessage For="() => user.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText class="form-control" type="password" @bind-Value="user.Password" autocomplete="new-password" />
                    <ValidationMessage For="() => user.Password" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm password</label>
                    <InputText class="form-control" type="password" @bind-Value="user.ConfirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => user.ConfirmPassword" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@busy">@(busy ? "Creating account..." : "Register")</button>
            </EditForm>

            <p class="mt-3 mb-0 small">Already registered? <a href="login">Log in</a></p>
        }
    </div>
</div>

@code {
    private Register user = new();
    private GeneralResponse? result;
    private bool busy;

    private async Task RegisterAsync()
    {
        busy = true;
        result = await AccountService.RegisterAsync(user);
        busy = false;
    }
}
